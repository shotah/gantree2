{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "middleware.ts!",
    "app/**/{page,layout,route,manifest}.{ts,tsx}!",
    "scripts/*.{ts,mjs}!",
    "harness/eval/live.ts!",
    "lib/pwa/iconPng.ts!",
    "lib/theme/contrast.ts!",
    "test/**/*.test.{ts,tsx}",
    "vitest.eval.config.ts"
  ],
  "project": [
    "**/*.{ts,tsx,mjs}!",
    "app/**/*.css!",
    "!test/**!"
  ],
  "ignore": [
    "harness/*/index.ts"
  ],
  "ignoreDependencies": [
    "next"
  ],
  "ignoreBinaries": [
    "celld"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": [
    "duplicates"
  ]
}
