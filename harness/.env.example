# Eval and local harness runs (`make integration-test`, `npm run eval`).
# Copy to harness/.env. Worker secrets do not belong here.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# CHANNEL=chat reads CHAT_MAILBOX_URL, CHAT_BEARER, CHAT_ALLOWED_USERS.
# CHAT_ALLOWED_USERS is optional when SNAPSHOT=true: the Agent DO owns admission.
# CHAT_MAILBOX_URL, PENDANT_BEARER, PENDANT_ALLOWED_USERS are deprecated aliases.
