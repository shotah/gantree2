# RentCast API (https://www.rentcast.io/api) — Developer plan ≈ 50 free req/month
RENTCAST_API_KEY=

# Optional override for tests / proxies
# RENTCAST_BASE_URL=https://api.rentcast.io/v1

# Local usage counter + caps (RentCast has no public quota API)
# RENTCAST_MONTHLY_QUOTA=50
# RENTCAST_SOFT_CAP=40
# Last 10 requests require confirm_spend=true on billed tools. 0 = hard cap only.
# RENTCAST_ALLOW_OVERAGE=1
# Human-only. Lets billed tools continue after the hard cap (paid plan). The model cannot set this.
# RENTCAST_USAGE_FILE=C:\Users\you\AppData\Roaming\rentals-search-mcp\usage.json
# RENTCAST_USAGE_TRACK=0
# Also disables soft/hard caps (no counter → nothing to enforce).
