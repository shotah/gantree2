# Google Health API — https://developers.google.com/health/setup
# Enable: https://console.cloud.google.com/apis/library/health.googleapis.com
# Then create an OAuth Web client (scopes Restricted — ≤100 test users until verification).
# Scopes are Restricted (≤100 test users until verification).
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# After `google-health-mcp auth` (or host `gantry auth ghealth`):
# GOOGLE_HEALTH_TOKEN_PATH=C:\Users\you\AppData\Roaming\google-health-mcp\tokens.json

# Optional API base override (tests / proxies)
# GOOGLE_HEALTH_BASE_URL=https://health.googleapis.com
