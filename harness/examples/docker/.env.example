# Consumer repo — copy to .env and set secrets.
# Compose maps GEMINI_* → gantry LLM_* (see compose.yml).

# --- Timezone (cron + "what time is it") -------------------------------------
TZ=America/Los_Angeles

# --- Gemini (required for default chat) --------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Or set all three to swap chat providers (xAI / Ollama / …):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-3.8-flash

# --- Channel -----------------------------------------------------------------
# telegram (default), discord, slack, stdio, or chat
CHANNEL=telegram

# Required when CHANNEL=telegram — allowlist only, no pairing
# @BotFather → token; @userinfobot → numeric id
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Required when CHANNEL=discord — docs/channels.md (Message Content Intent on)
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS=

# Required when CHANNEL=slack — docs/channels.md (Socket Mode)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=

# Required when CHANNEL=chat — docs/channels.md
# (CHANNEL=pendant is a deprecated alias)
# CHAT_MAILBOX_URL=wss://<origin>/ws/kit
# CHAT_BEARER=
# CHAT_ALLOWED_USERS=
# Deprecated aliases, read only when the CHAT_* name is unset:
# PENDANT_MAILBOX_URL, PENDANT_BEARER, PENDANT_ALLOWED_USERS

# --- Optional gantry knobs ---------------------------------------------------
# LLM_MAX_TOKENS=4096           # completion cap (0 = provider default)
# STREAM_REPLIES=true       # edit-in-place streaming (default)
# SHOW_THINKING=true        # CoT italics → expandable (default; needs STREAM_REPLIES)
# TOOL_TRACE=compact        # full|compact|off (needs STREAM_REPLIES)
# LOG_LEVEL=info
# MEMORY_ENABLED=true
# CRON_ENABLED=true
# TOOL_SCHEMA_MAX_TOKENS=0
# FEEDS_USER_AGENT=feeds-mcp/0.1 (you@example.com)
# X_BEARER_TOKEN=
# GOOGLE_MAPS_API_KEY=
# IMAGE_API_KEY=                    # else GEMINI/LLM key
# IMAGE_OUTPUT_DIR=/data/images      # photo_generate → chat avatar/backdrop handoff
# BRAVE_SEARCH_API_KEY=          # builtin web_search (https://api-dashboard.search.brave.com/)
