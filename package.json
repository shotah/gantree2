{
  "name": "gantree",
  "version": "0.2.28",
  "private": true,
  "description": "gantree — one repo, one door, one product. Settings and chat (PWA), on Cloudflare or celld.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "dev:shot": "CLOUDFLARE_ENV=shot vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:home": "npm run build && celld deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "badge": "node scripts/badge.mjs vitest coverage/coverage-summary.json badges/coverage.svg",
    "eval": "node scripts/eval.mjs",
    "agent": "node scripts/agent.ts",
    "icons": "node scripts/icons.ts",
    "seed": "node scripts/seed.ts",
    "shot": "node scripts/shot.mjs",
    "theme:export": "node scripts/theme-export.ts",
    "openapi": "node scripts/openapi.ts",
    "pages": "node scripts/pages.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "@vinext/cloudflare": "^1.1.0",
    "fast-png": "^8.0.0",
    "fast-xml-parser": "^5.11.2",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "jpeg-js": "^0.4.4",
    "marked": "^18.1.0",
    "mdast-util-to-string": "^4.0.0",
    "openai": "^7.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "strip-markdown": "^6.0.0",
    "unified": "^11.0.5",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "yaml": "^2.9.1"
  }
}
