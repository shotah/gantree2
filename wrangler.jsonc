{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gantree2",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  // The real URL. Cloudflare creates the DNS record and certificate for a
  // custom domain on deploy; the zone (bldhosting.com) must be on this account.
  "routes": [{ "pattern": "gantree.bldhosting.com", "custom_domain": true }],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Workers Logs show in the dashboard Logs tab and `wrangler tail`.
  // Free tier: 200k events/day, 3-day retention.
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "SETTINGS", "class_name": "Settings" },
      { "name": "AGENT", "class_name": "Agent" }
    ]
  },
  // Append-only. v2 added the Harness class for the container runtime;
  // v3 deletes it (and its objects). Never rewrite an applied tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Settings", "Agent"] },
    { "tag": "v2", "new_sqlite_classes": ["Harness"] },
    { "tag": "v3", "deleted_classes": ["Harness"] }
  ],
  "kv_namespaces": [
    { "binding": "DIRECTORY", "id": "TODO" }
  ],
  // Optional var. Public origin for OAuth redirects (path stripped).
  // Unset locally: callers fall back to the request origin.
  // "vars": { "PUBLIC_ORIGIN": "https://gantree.example.com" }
}
